# Unified Context Protocol — infra only (no API credentials).
# Consuming runtimes own keys, base URLs, and transport.

UCP_DEFAULT_FAMILY=anthropic
UCP_OPENWEIGHT_TEMPLATE=chatml
UCP_CACHE_THRESHOLD_TOKENS=1024
UCP_OPENWEIGHT_ENABLE_PREFIX_CACHE_HINT=true
UCP_ANTHROPIC_TOKENIZER_PATH=
UCP_OPENWEIGHT_TOKENIZER_PATH=
UCP_SYSTEM_PROMPT=You are a helpful assistant. Prior turns may have been produced by a different model family; continue coherently.
