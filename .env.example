# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_VERSION=2023-06-01

# Grok / xAI
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3

# Open-weight / local (Ollama, vLLM, LM Studio, Together, Fireworks, …)
OPENWEIGHT_API_KEY=
OPENWEIGHT_BASE_URL=http://127.0.0.1:11434/v1
OPENWEIGHT_MODEL=llama3.1
OPENWEIGHT_TEMPLATE=chatml
OPENWEIGHT_TOKENIZER_PATH=
OPENWEIGHT_ENABLE_PREFIX_CACHE=true

# Optional HF tokenizer.json for Anthropic-side alignment
ANTHROPIC_TOKENIZER_PATH=

# Session
DEFAULT_PROVIDER=anthropic
SYSTEM_PROMPT=You are a helpful assistant in a cross-model hot-swap REPL.
MAX_OUTPUT_TOKENS=4096
REQUEST_TIMEOUT_S=120
DUAL_WRITE_ENABLED=true
CACHE_THRESHOLD_TOKENS=1024
